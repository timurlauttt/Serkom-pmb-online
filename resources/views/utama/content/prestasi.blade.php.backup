@push('styles')
<style>
    .prestasi-card {
        transition: all 0.3s;
    }
    
    .prestasi-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 16px rgba(0,0,0,0.1);
    }
    
    @media (max-width: 768px) {
        div[style*="grid-template-columns: 300px 1fr"],
        div[style*="grid-template-columns: 2fr 1fr auto"] {
            grid-template-columns: 1fr !important;
        }
        
        div[style*="grid-template-columns: 300px 1fr"] img {
            height: 200px !important;
        }
    }
</style>
@endpush

@push('scripts')
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const searchInput = document.getElementById('searchInput');
        const categoryFilter = document.getElementById('categoryFilter');
        const resetBtn = document.getElementById('resetBtn');
        const prestasiCards = document.querySelectorAll('.prestasi-card');

        function filterPrestasi() {
            const searchTerm = searchInput.value.toLowerCase();
            const categoryValue = categoryFilter.value;

            prestasiCards.forEach(card => {
                const title = card.getAttribute('data-title').toLowerCase();
                const category = card.getAttribute('data-category');

                const matchSearch = title.includes(searchTerm);
                const matchCategory = !categoryValue || category === categoryValue;

                if (matchSearch && matchCategory) {
                    card.style.display = 'grid';
                } else {
                    card.style.display = 'none';
                }
            });
        }

        searchInput.addEventListener('input', filterPrestasi);
        categoryFilter.addEventListener('change', filterPrestasi);
        
        resetBtn.addEventListener('click', function() {
            searchInput.value = '';
            categoryFilter.value = '';
            filterPrestasi();
        });
    });
</script>
@endpush
